{
  "custom/resources": {
    "format": "󰒋",
    "tooltip": false
  },
  "cpu": {
    "tooltip": false,
    "interval": 10,
    "format": "󰻠 <span size='11pt'>{usage}%</span>",
    "format-alt": "󰻠",
    "states": {
      "warning": 75,
      "critical": 90
    }
  },
  "custom/gpu": {
    "exec": "cat /sys/class/drm/card*/device/gpu_busy_percent 2>/dev/null | sort -n | tail -n 1",
    "interval": 10,
    "format": "󰢮 <span size='11pt'>{}%</span>",
    "format-alt": "󰢮",
    "tooltip": false
  },
  "temperature": {
    "tooltip": false,
    "interval": 10,
    "thermal-zone": 8,
    "critical-threshold": 80,
    "format": "{icon} <span size='11pt'>{temperatureC}°C</span>",
    "format-alt": "{icon}",
    "format-critical": "<span size='12pt'>󱗗 </span><span size='11pt'>{temperatureC}°C</span>",
    "format-icons": [
      "",
      "",
      ""
    ]
  }
}

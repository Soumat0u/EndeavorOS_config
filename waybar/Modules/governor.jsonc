{
  "custom/governor": {
    "exec": "GOV=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor); case $GOV in powersave) ICON='󰌪';; schedutil) ICON='󰁹';; performance) ICON='󰓅';; esac; echo \"{\\\"text\\\":\\\"$ICON\\\",\\\"tooltip\\\":\\\"$GOV\\\"}\"",
    "return-type": "json",
    "interval": 3,
    "format": "{}"
  }
}

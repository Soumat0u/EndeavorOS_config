{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "none"
    },
    "display": {
        "separator": "  ",
        "constants": ["\u001b[38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}m", "\u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m"] 
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": "╭───────────────────────────────────╮"
        },
        {
            "type": "kernel",
            "key": "  {$2}  Kernel   ",
            "format": "{$1}{release}"
        },
        {
            "type": "command",
            "key": "  {$2}  Uptime   ",
            "text": "uptime -p | cut -d ' ' -f 2-",
            "format": "{$1}{}"
        },
        {
            "type": "shell",
            "key": "  {$2}  Shell    ",
            "format": "{$1}{pretty-name}"
        },
        {
            "type": "command",
            "key": "  {$2}  Memory   ",
            "text": "free -m | awk 'NR==2{printf \"%.2f GiB / %.2f GiB\",$3/1024,$2/1024}'",
            "format": "{$1}{}"
        },
        {
            "type": "packages",
            "key": "  {$2}  Packages ",
            "format": "{$1}{all}"
        },
        {
            "type": "command",
            "key": "  {$2}  User     ",
            "text": "echo $USER",
            "format": "{$1}{}"
        },
        {
            "type": "command",
            "key": "  {$2}󰻀  Distro   ",
            "text": "grep '^PRETTY_NAME=' /etc/os-release | cut -d'\"' -f2",
            "format": "{$1}{}"
        },
        {
            "type": "custom",
            "key": "╰───────────────────────────────────╯"
        },
        "break"
    ]
}

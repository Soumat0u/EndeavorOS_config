{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/home/safak/.config/fastfetch/ascii.txt",
        "color": {
            "1": "red",
            "2": "magenta",
            "3": "blue"
        }
    },
    "display": {
        "separator": "  ",
        "constants": [
            "\u001b[39m",
            "\u001b[34m"
        ]
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": "╭────────────────────────────────────────────────╮"
        },
        {
            "type": "os",
            "key": "  {$2}󰻀  OS       ",
            "format": "{$1}{pretty-name} {arch}"
        },
        {
            "type": "kernel",
            "key": "  {$2}  Kernel   ",
            "format": "{$1}{release}"
        },
        {
            "type": "uptime",
            "key": "  {$2}  Uptime   ",
            "format": "{$1}{}"
        },
        {
            "type": "shell",
            "key": "  {$2}  Shell    ",
            "format": "{$1}{pretty-name}"
        },
        {
            "type": "packages",
            "key": "  {$2}  Packages ",
            "format": "{$1}{all}"
        },
        {
            "type": "break"
        },
        {
            "type": "cpu",
            "key": "  {$2}  CPU      ",
            "format": "{$1}{name} ({cores-logical} Cores) @ {freq-max} [ {temperature} ]",
            "temp": true
        },
        {
            "type": "gpu",
            "key": "  {$2}󰢮  GPU      ",
            "format": "{$1}{name} {driver}",
            "hideType": "integrated"
        },
        {
            "type": "memory",
            "key": "  {$2}  Memory   ",
            "format": "{$1}{used} / {total} ({percentage}%)"
        },
        {
            "type": "disk",
            "key": "  {$2}󰋊  Disk     ",
            "format": "{$1}{size-used} / {size-total} ({size-percentage}%)"
        },
        {
            "type": "display",
            "key": "  {$2}󰍹  Display  ",
            "format": "{$1}{width}x{height} @ {refresh-rate}Hz"
        },
        {
            "type": "break"
        },
        {
            "type": "localip",
            "key": "  {$2}󰩟  Local IP ",
            "format": "{$1}{ipv4}"
        },
        {
            "type": "custom",
            "key": "╰────────────────────────────────────────────────╯"
        },
        "break"
    ]
}